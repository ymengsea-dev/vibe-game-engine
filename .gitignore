# Rust build artifacts
/target/
**/target/

# Editor / OS noise
.DS_Store
*.swp
.idea/
.vscode/

# Default dev project the editor scaffolds when run with no path argument
/RustyEngineProject/

# Per-user editor state stays local; stable asset IDs under .studio/assets/
# are project data and must be committed with scenes that reference them.
**/.studio/*
!**/.studio/assets/

# Games made with Studio stay local; only the Island regression project is
# part of the repo. The local games' tests need those folders.
/games/*
!/games/island/
/apps/player/tests/demos.rs

# Environment
.env

# private dev notes
NOTES.md

# Agent planning artifacts (specs and plans), kept local
.superpowers/
island-save.ron
